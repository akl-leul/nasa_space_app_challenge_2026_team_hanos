# Only needed for local development: copy to .env.local. Never commit real secrets (none are needed).
#
# Production values are set elsewhere: see docs/DEPLOYMENT.md.
#  - NEXT_PUBLIC_SITE_URL defaults to https://hanos.surf when unset (share links, QR codes, canonical URLs).
#  - API_BASE_URL is where /api/* is forwarded. On Vercel it is REQUIRED: the address of the API service on Render
#    (no trailing slash). Vercel then forwards /api/* to it.
#  - The API's own settings are set on the Render service (render.yaml).

# Public address of the site. Leave unset for the production address; set to the local address only while developing.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where /api/* is forwarded (the science API, services/api). Locally it runs on this machine.
API_BASE_URL=http://127.0.0.1:8000

# --- Science API (services/api), read by the Python process, not by Next.js ---
# HANOS_ENV=development        # turns on /api/docs and local CORS; production is the default
# HANOS_CACHE_DIR=             # default services/api/cache
# HANOS_SQLITE_WAL=1           # 0 only when the cache is on a network share
# HANOS_CORS_ORIGINS=          # comma separated, only if another site calls the API directly
# HANOS_RATE_PER_MIN=1200
# HANOS_HEAVY_PER_MIN=300
# HANOS_MAX_JOBS=32
# HANOS_FRAME_SLOTS=10
# HANOS_LOG_LEVEL=INFO
